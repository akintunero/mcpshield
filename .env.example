# =============================================================================
# MCPShield — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# --- MCP Server -----------------------------------------------------------
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=7801
MCP_SERVER_URL=http://localhost:7801/sse
MCP_API_KEY=change-me
MCPSHIELD_STATE_DIR=./.mcpshield-state
CORS_ORIGINS=*

# --- API + Dashboard ------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=7802
API_BASE_URL=http://localhost:7802
API_KEY=change-me

# --- AWS Credentials (required for cloud-aws plugin) ----------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Slack (optional — omit to disable the Slack bot) ---------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- LLM Provider ---------------------------------------------------------
# Options: nim (default), ollama, gemini, openai-compatible
LLM_PROVIDER=nim
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=meta/llama-3.1-70b-instruct

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- State Encryption (optional — omit to store as plaintext) -----------
# Set a passphrase to encrypt state.json at rest using AES-256-GCM.
# WARNING: Changing this key will invalidate existing state files.
MCPSHIELD_STATE_KEY=

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production
